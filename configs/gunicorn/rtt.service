[Unit]
Description=Gunicorn instance to serve NIST Tests
After=network.target

[Service]
User=jcastillo
Group=jcastillo
WorkingDirectory=/opt/web_app
ExecStart=/home/jcastillo/nist/env-nist-tests/bin/gunicorn -k gthread --workers=16 --threads=1 --timeout=360 --bind 127.0.0.1:8000 wsgi:app
Restart=always

[Install]
WantedBy=multi-user.target
